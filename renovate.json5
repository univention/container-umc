{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "The upstream Traefik image the mirror-image CI component copies",
      // The component takes the reference as three inputs, so one matchString
      // spans all three lines. They have to stay adjacent and in this order.
      "managerFilePatterns": [
        "/^\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "source: \"(?<depName>[^\"]+)\"\\s+tag: \"(?<currentValue>[^\"]+)\"\\s+digest: \"(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The chart's Traefik pin, looked up where the mirror copies it from",
      // helm-values would look library/traefik up on Docker Hub,
      // whose digest differs from the ghcr.io one Harbor holds.
      "managerFilePatterns": [
        "/^helm/umc-server/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository: \"library/traefik\"\\s+tag: \"(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "depNameTemplate": "ghcr.io/traefik/traefik",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "The custom manager owns the chart's Traefik pin",
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "library/traefik"
      ],
      "enabled": false
    },
    {
      "description": "One merge request moves the chart pin and the mirror pin",
      "matchPackageNames": [
        "ghcr.io/traefik/traefik"
      ],
      "groupName": "Traefik",
      "prBodyNotes": [
        "cc @jlohmer @fbest @ccastens @fbotner @jconde @ekipsang"
      ],
      // Renovate only fires postUpgradeTasks that are part of the branch-level
      // config, so the task belongs on the group rule.
      "postUpgradeTasks": {
        "commands": [
          "helm-docs"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
